{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME"],
      "inputs": [
        "package.json",
        "app.json",
        "react-native.config.js",
        "android",
        "!android/build",
        "!android/.gradle",
        "!android/app/build",
        "!android/app/.cxx"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "Gemfile",
        "ios",
        "!ios/build",
        "!ios/Pods"
      ],
      "outputs": []
    }
  }
}
